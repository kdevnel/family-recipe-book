# Ignore OS-specific files
.DS_Store
Thumbs.db
*.swp
*.swo
*.vi
*~
*.orig
*.rej
*.log
*.err

# Ignore editor-specific files
.idea
.vscode
*.sublime-project
*.sublime-workspace
*.komodoproject
.komodotools
.project
.settings
.tmproj
*.esproj
nbproject

# Ignore dependency directories
/vendor/
/node_modules/

# Ignore WordPress core files (if not version controlled)
/wp-admin/
/wp-includes/
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/cache/
/wp-content/backups/
/wp-content/backup-db/
/wp-content/advanced-cache.php
/wp-content/object-cache.php
/wp-content/blogs.dir/
/wp-content/plugins/hello.php
/wp-content/themes/twenty*/

# Ignore Composer files
composer.lock
composer.phar

# Ignore npm/yarn files
package-lock.json
yarn.lock
npm-debug.log
yarn-error.log

# Ignore build artifacts
/dist/
/build/
*.min.js
*.min.css
*.map

# Ignore environment files
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# Ignore WordPress debug log
/debug.log

# Ignore IDE files
.htaccess
*.sql
*.zip
*.tar.gz
*.rar

# Ignore WordPress core files (if not version controlled)
/wp-config.php
/wp-content/index.php
/wp-content/themes/index.php
/wp-content/plugins/index.php
