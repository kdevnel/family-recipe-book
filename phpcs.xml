<?xml version="1.0"?>
<ruleset name="Family Recipe Book Coding Standards">
    <description>PHP CodeSniffer configuration for Family Recipe Book project using WordPress Coding Standards</description>

    <!-- Show progress and sniff codes -->
    <arg value="ps"/>
    <arg name="colors"/>

    <!-- Use WordPress as the base -->
    <rule ref="WordPress"/>

    <!-- Set installed standards paths -->
    <config name="installed_paths" value="vendor/wp-coding-standards/wpcs"/>

    <!-- Paths to check -->
    <file>dvnl-family-recipe-book</file>

    <!-- Exclude some folders -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/*.js</exclude-pattern>
    <exclude-pattern>*/*.css</exclude-pattern>

    <!-- WordPress specific rules configuration -->
    <config name="minimum_supported_wp_version" value="6.0"/>

    <!-- Allow short array syntax -->
    <rule ref="Generic.Arrays.DisallowShortArraySyntax.Found">
        <severity>0</severity>
    </rule>

    <!-- Text domain -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="dvnl-family-recipe-book"/>
            </property>
        </properties>
    </rule>

    <!-- Allow WordPress filename exceptions -->
    <rule ref="WordPress.Files.FileName">
        <properties>
            <property name="strict_class_file_names" value="false"/>
        </properties>
    </rule>
</ruleset>
