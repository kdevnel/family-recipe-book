{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 2,
    "name": "dvnl/recipe-ingredients",
    "version": "1.0.0",
    "title": "Recipe Ingredients",
    "category": "widgets",
    "icon": "list-view",
    "description": "Add a list of ingredients for your recipe.",
    "supports": {
        "html": false,
        "multiple": false
    },
    "textdomain": "family-recipe-book",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css",
    "attributes": {
        "ingredients": {
            "type": "array",
            "default": []
        },
        "title": {
            "type": "string",
            "default": "Ingredients"
        }
    }
}