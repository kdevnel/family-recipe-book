{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 2,
    "name": "dvnl/recipe-details",
    "version": "1.0.0",
    "title": "Recipe Details",
    "category": "widgets",
    "icon": "food",
    "description": "Display recipe details like preparation time, cooking time, servings, etc.",
    "keywords": ["recipe", "details", "cooking"],
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    },
    "attributes": {
        "prepTime": {
            "type": "string",
            "default": ""
        },
        "cookTime": {
            "type": "string",
            "default": ""
        },
        "totalTime": {
            "type": "string",
            "default": ""
        },
        "servings": {
            "type": "string",
            "default": ""
        },
        "calories": {
            "type": "string",
            "default": ""
        },
        "difficulty": {
            "type": "string",
            "default": "medium"
        }
    },
    "textdomain": "family-recipe-book",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css"
}