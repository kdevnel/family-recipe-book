{
  "name": "family-recipe-book",
  "version": "1.0.0",
  "description": "A WordPress plugin for managing family recipes with modern best practices.",
  "main": "build/blocks.js",
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "lint:js": "wp-scripts lint-js",
    "lint:css": "wp-scripts lint-style",
    "lint:php": "composer lint",
    "format:js": "wp-scripts format",
    "packages-update": "wp-scripts packages-update",
    "check-engines": "wp-scripts check-engines",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:destroy": "wp-env destroy",
    "env:logs": "wp-env logs",
    "env:run": "wp-env run",
    "env:cli": "wp-env run cli wp",
    "env:phpunit": "wp-env run phpunit",
    "test:php": "wp-env run phpunit 'phpunit -c /var/www/html/wp-content/plugins/family-recipe-book/phpunit.xml.dist'",
    "dev": "concurrently \"npm run start\" \"npm run env:start\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/family-recipe-book.git"
  },
  "keywords": [
    "wordpress",
    "plugin",
    "recipes",
    "gutenberg",
    "blocks"
  ],
  "author": "Your Name",
  "license": "GPL-2.0-or-later",
  "bugs": {
    "url": "https://github.com/yourusername/family-recipe-book/issues"
  },
  "homepage": "https://github.com/yourusername/family-recipe-book#readme",
  "devDependencies": {
    "@wordpress/env": "^8.13.0",
    "@wordpress/eslint-plugin": "^14.0.0",
    "@wordpress/scripts": "^26.0.0",
    "@wordpress/stylelint-config": "^21.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "concurrently": "^8.2.0",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "eslint": "^8.32.0",
    "postcss-loader": "^8.1.1",
    "stylelint": "^14.16.1"
  },
  "dependencies": {
    "@wordpress/block-editor": "^11.0.0",
    "@wordpress/blocks": "^12.0.0",
    "@wordpress/components": "^23.0.0",
    "@wordpress/data": "^8.0.0",
    "@wordpress/element": "^5.0.0",
    "@wordpress/i18n": "^4.0.0"
  }
}
