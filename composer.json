{
    "name": "devnel/family-recipe-book",
    "description": "WordPress plugin for maintaining a family recipe book",
    "type": "wordpress-plugin",
    "autoload": {
        "psr-4": {
            "Dvnl\\FamilyRecipeBook\\": "dvnl-family-recipe-book/"
        }
    },
    "authors": [
        {
            "name": "Kyle Nel",
            "email": "22053773+kdevnel@users.noreply.github.com"
        }
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.0",
        "squizlabs/php_codesniffer": "^3.7",
        "php-stubs/wordpress-stubs": "^6.7",
        "phpstan/phpstan": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },
    "scripts": {
        "cs": "phpcs",
        "cs-fix": "phpcbf",
		"phpstan": "phpstan --memory-limit=2G analyse"
    }
}
