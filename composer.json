{
    "name": "dvnl/family-recipe-book",
    "description": "A WordPress plugin for managing family recipes with modern best practices.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Your Name",
            "email": "your.email@example.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "yoast/phpunit-polyfills": "^4.0",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.5",
        "php-stubs/wordpress-stubs": "^6.8",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "phpstan/extension-installer": "^1.4",
        "captainhook/captainhook-phar": "^5.25",
        "wp-coding-standards/wpcs": "^3.0.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/php-compatibility": "*",
        "phpcompatibility/phpcompatibility-wp": "*"
    },
    "prefer-stable": true,
    "scripts": {
        "lint": "phpcs",
        "fix": "phpcbf",
        "test": "phpunit",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=2G",
        "phpstan-baseline": "vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --generate-baseline --memory-limit=2G",
        "test:coverage": "phpunit --coverage-html coverage"
    },
    "autoload": {
        "psr-4": {
            "dvnl\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "dvnl\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "captainhook/captainhook-phar": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
